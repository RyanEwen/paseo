{
  "description": "Keep Paseo++ README, settings help and developer docs aligned during Codex work.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-docs-hook.mjs\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\scripts\\codex-docs-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading documentation review checklist",
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-docs-hook.mjs\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\scripts\\codex-docs-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking documentation review needs",
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex-docs-hook.mjs\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\scripts\\codex-docs-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Reviewing fork documentation before finishing",
            "additionalContextLimit": 3000
          }
        ]
      }
    ]
  }
}
