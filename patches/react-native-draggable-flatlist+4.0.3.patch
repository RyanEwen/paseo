--- /dev/null
+++ b/node_modules/react-native-draggable-flatlist/src/drag-session.ts
@@ -0,0 +1,42 @@
+/** Captured identity and ordered membership for one native drag, including its settling spring. */
+export interface DragSessionSnapshot {
+  sessionId: number;
+  key: string;
+  index: number;
+  revision: number;
+  orderedKeys: readonly string[];
+}
+
+export interface DragCompletion {
+  sessionId: number;
+  from: number;
+  to: number;
+  finished: boolean;
+}
+
+interface CommitDragCompletionInput {
+  session: DragSessionSnapshot | null;
+  completion: DragCompletion;
+  revision: number;
+  orderedKeys: readonly string[];
+  onCommit: (indices: { from: number; to: number }) => void;
+}
+
+/** Only the original dragged key and ordered membership can commit a finished spring. */
+export function commitDragCompletion({
+  session,
+  completion,
+  revision,
+  orderedKeys,
+  onCommit,
+}: CommitDragCompletionInput): boolean {
+  if (!session || !completion.finished || completion.sessionId !== session.sessionId) return false;
+  if (revision !== session.revision || orderedKeys.length !== session.orderedKeys.length)
+    return false;
+  if (orderedKeys.some((key, index) => key !== session.orderedKeys[index])) return false;
+  if (completion.from !== session.index || orderedKeys[completion.from] !== session.key)
+    return false;
+  if (completion.to < 0 || completion.to >= orderedKeys.length) return false;
+  onCommit({ from: session.index, to: completion.to });
+  return true;
+}
