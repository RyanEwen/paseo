{
  "manifest_version": 3,
  "name": "Paseo extension compatibility fixture",
  "version": "1.0.0",
  "permissions": ["tabs", "storage", "webNavigation", "notifications", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
