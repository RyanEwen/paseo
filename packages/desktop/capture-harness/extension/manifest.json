{
  "manifest_version": 3,
  "name": "Paseo browser profile fixture",
  "version": "1.0.0",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
